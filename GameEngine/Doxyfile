# Doxygen configuration for the Zappy graphical client.

PROJECT_NAME           = "Zappy GameEngine"
PROJECT_BRIEF          = "Graphical client, renderers, protocol model, and GUI controls."
OUTPUT_DIRECTORY       = GameEngine/docs
CREATE_SUBDIRS         = NO

INPUT                  = GameEngine/include GameEngine/src GameEngine/graphics GameEngine/mainpage.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp *.md
EXCLUDE_PATTERNS       =

USE_MDFILE_AS_MAINPAGE = GameEngine/mainpage.md

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

OPTIMIZE_OUTPUT_FOR_C  = NO
TYPEDEF_HIDES_STRUCT   = NO
MARKDOWN_SUPPORT       = YES

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

QUIET                  = NO
